#!/usr/bin/env bash
# usb-driver - CLI for mounting EXT4 USB drives in WSL2
set -e

# =========================
# Resolve paths (follow symlinks)
# =========================
get_real_path() {
    local path="$1"
    # Follow symlink to absolute path
    readlink -f "$path"
}

REAL_SCRIPT=$(get_real_path "${BASH_SOURCE[0]}")
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# =========================
# Source libraries
# =========================
source "$PROJECT_ROOT/lib/constants.sh"
source "$PROJECT_ROOT/lib/logging.sh"
source "$PROJECT_ROOT/lib/tui.sh"
source "$PROJECT_ROOT/lib/checks.sh"
source "$PROJECT_ROOT/lib/usbipd.sh"
source "$PROJECT_ROOT/lib/mount_ext4.sh"

# =========================
# Load config safely (no arbitrary code execution)
# =========================
CONFIG_FILE="$HOME/.config/usb-driver/config"
load_safe_config "$CONFIG_FILE"

# =========================
# Config Migration (v0.6.0+)
# =========================
if [ -d "$HOME/.config/bkp-pendrive" ] && [ ! -d "$HOME/.config/usb-driver" ]; then
    log_warn "Migrando diretório de configuração: bkp-pendrive -> usb-driver"
    mv "$HOME/.config/bkp-pendrive" "$HOME/.config/usb-driver"
    log_success "Diretório de configuração atualizado."
fi

# Defaults
MOUNT_POINT="${MOUNT_POINT:-$DEFAULT_MOUNT_POINT}"

# =========================
# Legacy Migration (v0.5.1+)
# =========================
if [ "$MOUNT_POINT" = "$LEGACY_MOUNT_POINT" ]; then
    log_warn "Migrando caminho legado: $LEGACY_MOUNT_POINT -> $DEFAULT_MOUNT_POINT"
    
    # Update current session
    MOUNT_POINT="$DEFAULT_MOUNT_POINT"
    
    # Update config file if exists
    if [ -f "$CONFIG_FILE" ]; then
        sed -i "s|MOUNT_POINT=\"$LEGACY_MOUNT_POINT\"|MOUNT_POINT=\"$DEFAULT_MOUNT_POINT\"|" "$CONFIG_FILE"
        log_success "Configuração atualizada para o novo padrão."
    fi
    
    # Try to remove old empty directory if possible
    if [ -d "$LEGACY_MOUNT_POINT" ] && ! mountpoint -q "$LEGACY_MOUNT_POINT" 2>/dev/null; then
        sudo rmdir "$LEGACY_MOUNT_POINT" 2>/dev/null || true
    fi
fi
PENDRIVE_LABEL="${PENDRIVE_LABEL:-}"
SIMULATE_MODE=false
JSON_MODE=false
ALL_MODE=false

# =========================
# Version
# =========================
VERSION=$(cat "$PROJECT_ROOT/VERSION" 2>/dev/null || echo "dev")

# =========================
# Help
# =========================
show_help() {
    echo -e "${CYAN}${BOLD}"
    echo -e "  _   _  ____  ____        ____   ____   ___ _     _ _____ ____  "
    echo -e " | | | |/ ___|| __ )      |  _ \\ |  _ \\ |_ _\\ \\   / / ____|  _ \\ "
    echo -e " | | | |\\___ \\|  _ \\ _____| | | || |_) | | | \\ \\ / /|  _| | |_) |"
    echo -e " | |_| | ___) | |_) |_____| |_| ||  _ <  | |  \\ V / | |___|  _ < "
    echo -e "  \\___/ |____/|____/      |____/ |_| \\_\\|___|  \\_/  |_____|_| \\_\\"
    echo -e "${NC}"
    echo -e "                                         ${DIM}Version $VERSION${NC}"
    echo
    log_info "Simplifying USB storage management in WSL2"
    echo
    echo -e "${YELLOW}${BOLD}USO:${NC}"
    echo -e "  ${BOLD}usb-driver${NC} <comando> [opções]"
    echo
    echo -e "${YELLOW}${BOLD}COMANDOS:${NC}"
    echo -e "  ${GREEN}up, mount${NC}       Anexa e monta os dispositivos detectados"
    echo -e "  ${GREEN}down, unmount${NC}   Desmonta dispositivos gerenciados"
    echo -e "  ${GREEN}status${NC}          Mostra o estado atual das montagens"
    echo -e "  ${GREEN}list${NC}            Lista dispositivos USB (WSL + Windows)"
    echo -e "  ${GREEN}attach <ID>${NC}     Anexa um BUSID específico do Windows ao WSL"
    echo -e "  ${GREEN}check${NC}           Verifica a integridade do ambiente"
    echo -e "  ${GREEN}help${NC}            Exibe este manual"
    echo
    echo -e "${YELLOW}${BOLD}OPÇÕES:${NC}"
    echo -e "  ${CYAN}--select, -s${NC}    Escolhe o dispositivo manualmente no ${DIM}up${NC}"
    echo -e "  ${CYAN}--all, -a${NC}       Monta todos os dispositivos sem perguntar"
    echo -e "  ${CYAN}--force${NC}         Força desmontagem mesmo sob uso"
    echo -e "  ${CYAN}--eject${NC}         Ejeta do WSL após desmontar"
    echo -e "  ${CYAN}--simulate${NC}      Executa em modo de demonstração"
    echo -e "  ${CYAN}--json${NC}          Saída estruturada em JSON (para integrações/GUI)"
    echo -e "  ${CYAN}-v, --verbose${NC}   Mostra detalhes adicionais de execução"
    echo
    echo -e "${YELLOW}${BOLD}EXEMPLOS:${NC}"
    echo -e "  ${DIM}# Montar tudo automaticamente:${NC}"
    echo -e "  ${BOLD}usb-driver up${NC}"
    echo
    echo -e "  ${DIM}# Desmontar um dispositivo específico:${NC}"
    echo -e "  ${BOLD}usb-driver down${NC}"
    echo
    echo -e "  ${DIM}# Verificar onde os arquivos estão:${NC}"
    echo -e "  ${BOLD}ls $MOUNT_POINT${NC}"
    echo
    echo -e "${DIM}------------------------------------------------------------${NC}"
    echo -e "${DIM}Distribuído sob licença MIT. Desenvolvido para a comunidade.${NC}"
}

# =========================
# Parse args
# =========================
COMMAND=""
BUSID_ARG=""
SELECT_MODE=false
VERBOSE_MODE=false
EXTRA_FLAGS=()
for arg in "$@"; do
    case "$arg" in
        --simulate)
            SIMULATE_MODE=true
            ;;
        --json)
            JSON_MODE=true
            ;;
        --all|-a)
            ALL_MODE=true
            ;;
        --force|--eject)
            EXTRA_FLAGS+=("$arg")
            ;;
        --select|-s)
            SELECT_MODE=true
            ;;
        -v|--verbose)
            VERBOSE_MODE=true
            ;;
        -h|--help)
            COMMAND="help"
            ;;
        *)
            if [ -z "$COMMAND" ]; then
                COMMAND="$arg"
            elif [ -z "$BUSID_ARG" ]; then
                BUSID_ARG="$arg"
            fi
            ;;
    esac
done

# =========================
# Commands
# =========================

# Interactive device selection - shows menu and returns info
# Returns format: "type:id:vidpid" (e.g., "wsl:/dev/sdh1:04e8:6860" or "win:2-16:04e8:6860")
select_usb_device() {
    # Print menu to stderr so it shows on screen
    echo -e "\n${CYAN}▶${NC} ${BOLD}Selecione o dispositivo USB para montar:${NC}\n" >&2
    
    local options=()
    local i=1
    
    # 1. Get ALL storage devices from Windows (The primary source of truth)
    # We display them, and if they are already attached, we'll map them to WSL devices
    while IFS= read -r line; do
        local busid vidpid desc state
        busid=$(echo "$line" | awk '{print $1}')
        validate_busid "$busid" || continue
        
        vidpid=$(echo "$line" | awk '{print $2}')
        state=$(parse_usbipd_state "$line")
        
        desc=$(echo "$line" | awk '{for(j=3;j<NF;j++) printf "%s ", $j}' | cut -c1-45)

        if [[ "$state" == "Attached" ]]; then
            # If attached, find the corresponding device in WSL
            # We use the VID:PID to pin the search
            local wsl_dev
            wsl_dev=$(detect_usb_device "$vidpid" || true)
            
            if [ -n "$wsl_dev" ]; then
                options+=("wsl|$wsl_dev|$vidpid")
                echo -e "  ${BOLD}[$i]${NC} ${YELLOW}$wsl_dev${NC} ${GREEN}(Já no WSL)${NC} - $desc" >&2
            else
                # Fallback to win type if WSL detection is tricky, but it's attached
                options+=("win|$busid|$vidpid")
                echo -e "  ${BOLD}[$i]${NC} ${YELLOW}$busid${NC} ${GREEN}(Anexado)${NC} - $desc" >&2
            fi
        else
            options+=("win|$busid|$vidpid")
            echo -e "  ${BOLD}[$i]${NC} ${YELLOW}$busid${NC} (Windows) - $desc" >&2
        fi
        ((i++)) || true
        
    done < <(list_usb_devices | grep -i "$USB_STORAGE_FILTER" || true)
    
    if [ ${#options[@]} -eq 0 ]; then
        echo -e "${RED}[ERROR]${NC} Nenhum dispositivo USB encontrado no Windows" >&2
        return 1
    fi

    # --all / -a flag: select all without prompting
    if $ALL_MODE; then
        printf "%s\n" "${options[@]}"
        return 0
    fi

    # Add "All" option if more than one device
    if [ ${#options[@]} -gt 1 ]; then
        echo -e "  ${BOLD}[a]${NC} Montar TODOS" >&2
    fi
    
    if [ ${#options[@]} -eq 1 ] && ! $SELECT_MODE; then
        # Auto-select if only one option and not in explicit select mode
        echo "${options[0]}"
        return 0
    fi

    echo >&2
    echo -n "  Digite o número ou 'a' [1-${#options[@]}]: " >&2
    read -r choice < /dev/tty
    
    if [ "$choice" = "a" ] && [ ${#options[@]} -gt 1 ]; then
        # Return all options joined by newline
        printf "%s\n" "${options[@]}"
        return 0
    fi
    
    # Validate choice
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#options[@]} ]; then
        echo -e "${RED}[ERROR]${NC} Opção inválida" >&2
        return 1
    fi
    
    # Return selected option info
    echo "${options[$((choice-1))]}"
}
cmd_up() {
    local direct_target="${1:-}"

    if $SIMULATE_MODE; then
        if $JSON_MODE; then
            printf '{"ok":true,"simulated":true,"mountPoint":"%s/SIMULATED_USB","message":"Dispositivo simulado montado"}\n' "$(json_escape "$MOUNT_POINT")"
        else
            print_step "Iniciando montagem do dispositivo..."
            log_info "[SIMULATE] Verificando usbipd-win..."
            log_info "[SIMULATE] Anexando USB ao WSL..."
            log_info "[SIMULATE] Detectando dispositivo USB..."
            log_success "[SIMULATE] Pendrive montado em $MOUNT_POINT"
        fi
        return 0
    fi

    # Direct mount of an already-attached WSL block device (e.g., /dev/sdg1)
    if [ -n "$direct_target" ]; then
        if ! validate_device_node "$direct_target"; then
            if $JSON_MODE; then
                printf '{"ok":false,"message":"Dispositivo inválido: %s"}\n' "$(json_escape "$direct_target")"
            else
                log_error "Dispositivo inválido: $direct_target"
            fi
            return 1
        fi
        if ! is_safe_device "$direct_target"; then
            if $JSON_MODE; then
                printf '{"ok":false,"message":"Dispositivo bloqueado pela política de segurança: %s"}\n' "$(json_escape "$direct_target")"
            else
                log_error "Dispositivo bloqueado pela política de segurança: $direct_target"
            fi
            return 1
        fi
        local d_label d_mount_name d_out d_err
        d_label=$(lsblk -no LABEL "$direct_target" 2>/dev/null | head -1)
        d_mount_name=$(sanitize_mount_name "$d_label" "usb-$(basename "$direct_target")")
        if $JSON_MODE; then
            if d_out=$(mount_ext4 "$direct_target" "$d_mount_name" 2>&1); then
                printf '{"ok":true,"device":"%s","mountPoint":"%s/%s"}\n' \
                    "$(json_escape "$direct_target")" "$(json_escape "${MOUNT_POINT%/}")" "$(json_escape "$d_mount_name")"
                return 0
            else
                d_err=$(printf '%s' "$d_out" | tail -n 1 | sed 's/\x1b\[[0-9;]*m//g')
                printf '{"ok":false,"device":"%s","message":"%s"}\n' \
                    "$(json_escape "$direct_target")" "$(json_escape "${d_err:-Falha ao montar dispositivo}")"
                return 1
            fi
        else
            mount_ext4 "$direct_target" "$d_mount_name"
            return $?
        fi
    fi

    if ! $JSON_MODE; then
        print_step "Iniciando montagem do dispositivo..."
        log_info "usb-driver v$VERSION - Iniciando montagem"
    fi
    log_debug "MOUNT_POINT=$MOUNT_POINT"
    log_debug "SELECT_MODE=$SELECT_MODE, ALL_MODE=$ALL_MODE, VERBOSE_MODE=$VERBOSE_MODE"
    
    # 1. Health check (basics)
    log_debug "Running health checks..."
    if ! check_wsl; then
        if $JSON_MODE; then
            echo '{"ok":false,"message":"Não está executando no WSL"}'
        else
            health_check_wsl || true
        fi
        exit 1
    fi

    # 2. Selection (try Windows usbipd first; fallback to already-attached WSL USB devices)
    local selections=()
    if check_usbipd_installed; then
        log_debug "Starting device selection..."
        IFS=$'\n' read -d '' -r -a selections < <(select_usb_device) || true
        set -e
    fi

    if [ ${#selections[@]} -eq 0 ]; then
        local wsl_fallback
        wsl_fallback=$(detect_usb_device "" || true)
        if [ -n "$wsl_fallback" ]; then
            selections+=("wsl|$wsl_fallback|local")
        fi
    fi

    if [ ${#selections[@]} -eq 0 ]; then
        if $JSON_MODE; then
            echo '{"ok":false,"message":"Nenhum dispositivo USB encontrado no Windows ou no WSL2"}'
        else
            log_error "Nenhum dispositivo USB encontrado no Windows ou no WSL2"
        fi
        exit 1
    fi
    
    for selection in "${selections[@]}"; do
        [ -z "$selection" ] && continue
        
        local type id vidpid
        type=$(echo "$selection" | cut -d'|' -f1)
        id=$(echo "$selection" | cut -d'|' -f2)
        vidpid=$(echo "$selection" | cut -d'|' -f3)
        
        print_step "Processando: $id ($vidpid)..."
    
    local device=""
    
    # 3. Handle selection
    if [ "$type" = "win" ]; then
        # Selection is in Windows -> Attach it
        local busid="$id"
        log_info "Encontrado dispositivo USB (BUSID=$busid, VID:PID=$vidpid)"
        log_info "Anexando ao WSL..."
        
        # Try attach first (works if already bound)
        local attach_output
        attach_output=$(attach_usb_raw "$busid" || true)
        
        if echo "$attach_output" | grep -qiE "not shared|bind"; then
            # Device needs to be bound first (requires admin)
            echo >&2
            # Try to detach first to clear any stuck sessions
            detach_usb "$busid" >/dev/null 2>&1 || true

            # Use PowerShell to start-process with RunAs (triggers UAC)
            bind_usb "$busid"
            
            log_info "Autorização concluída. Aguardando estabilização (${STABILIZATION_DELAY}s)..."
            sleep "$STABILIZATION_DELAY"
            
            # Try attach again with a mini-retry loop
            log_info "Tentando anexar novamente..."
            local a_retry=0
            while [ "$a_retry" -lt "$ATTACH_RETRIES" ]; do
                attach_output=$(attach_usb_raw "$busid" || true)
                if echo "$attach_output" | grep -qi "success\|already\|Attached"; then
                    break
                fi
                if echo "$attach_output" | grep -qi "busy"; then
                    log_warn "Dispositivo ocupado no Windows. Nova tentativa em ${ATTACH_DELAY}s... ($((a_retry+1))/$ATTACH_RETRIES)"
                    sleep "$ATTACH_DELAY"
                else
                    echo "$attach_output" >&2
                    break
                fi
                ((a_retry++)) || true
            done
        fi
        
        # Wait for device to appear in WSL (with a retry loop)
        log_info "Aguardando inicialização do dispositivo (pinning by $vidpid)..."
        local retry=0
        while [ "$retry" -lt "$DEVICE_DETECTION_RETRIES" ]; do
            # Use VID:PID for pinning detection
            device=$(detect_usb_device "$vidpid" || true)
            if [ -n "$device" ]; then
                break
            fi
            echo -n "." >&2
            sleep 2
            ((retry++)) || true
        done
        echo "" >&2
        
    elif [ "$type" = "wsl" ]; then
        # Selection is already in WSL
        device="$id"
        log_info "Usando dispositivo já anexado ($vidpid): $device"
    fi
    
    # 4. Final Mount check
    if [ -z "$device" ]; then
        log_error "Nenhum dispositivo de armazenamento encontrado no WSL para $id."
        log_hint "Verifique se a partição do dispositivo é de um tipo suportado (EXT4, NTFS, FAT32)."
        continue
    fi
    
    # 4. Determine mount name (sanitized against path traversal)
    local label mount_name
    label=$(lsblk -no LABEL "$device" 2>/dev/null | head -1)
    mount_name=$(sanitize_mount_name "$label" "usb-$id")
    
    # 5. Perform mount in subdirectory
    if $JSON_MODE; then
        local mount_out
        if mount_out=$(mount_ext4 "$device" "$mount_name" 2>&1); then
            printf '{"ok":true,"device":"%s","mountPoint":"%s/%s"}\n' \
                "$(json_escape "$device")" "$(json_escape "${MOUNT_POINT%/}")" "$(json_escape "$mount_name")"
        else
            local clean_err
            clean_err=$(printf '%s' "$mount_out" | tail -n 1 | sed 's/\x1b\[[0-9;]*m//g')
            printf '{"ok":false,"device":"%s","message":"%s"}\n' \
                "$(json_escape "$device")" "$(json_escape "${clean_err:-Falha ao montar dispositivo}")"
            return 1
        fi
    else
        mount_ext4 "$device" "$mount_name" || true
    fi
    done
}
cmd_down() {
    local target_arg="${1:-}"
    local base_mount="${MOUNT_POINT:-$DEFAULT_MOUNT_POINT}"
    base_mount="${base_mount%/}"

    if $SIMULATE_MODE; then
        if $JSON_MODE; then
            printf '{"ok":true,"simulated":true,"unmounted":"%s","message":"Simulação de desmontagem concluída"}\n' "$(json_escape "${target_arg:-$base_mount/SIMULATED_USB}")"
        else
            print_step "Desmontando dispositivo(s)..."
            log_success "[SIMULATE] Dispositivo desmontado com segurança"
        fi
        return 0
    fi

    # Non-interactive unmount when explicit target path is passed (used by GUI / scripts)
    if [ -n "$target_arg" ]; then
        target_arg="${target_arg%/}"
        if [[ "$target_arg" != "$base_mount/"* && "$target_arg" != "$LEGACY_MOUNT_POINT/"* ]]; then
            if $JSON_MODE; then
                printf '{"ok":false,"message":"Alvo fora dos diretórios gerenciados"}\n'
            else
                log_error "Alvo fora dos diretórios gerenciados: $target_arg"
            fi
            return 1
        fi
        if $JSON_MODE; then
            if safe_unmount "$target_arg" "${EXTRA_FLAGS[@]}" >/dev/null 2>&1; then
                printf '{"ok":true,"unmounted":"%s"}\n' "$(json_escape "$target_arg")"
                return 0
            else
                printf '{"ok":false,"unmounted":"%s","message":"Falha ao desmontar dispositivo"}\n' "$(json_escape "$target_arg")"
                return 1
            fi
        else
            safe_unmount "$target_arg" "${EXTRA_FLAGS[@]}"
            return $?
        fi
    fi

    if ! $JSON_MODE; then
        print_step "Desmontando dispositivo(s)..."
    fi
    
    # Find all active mounts under our base directory OR legacy directory
    # sorted by path length (descending)
    local active_mounts=()
    while IFS= read -r mnt; do
        [ -n "$mnt" ] && active_mounts+=("$mnt")
    done < <(findmnt -lo TARGET -n | grep -E "^($base_mount|$LEGACY_MOUNT_POINT)" | awk '{ print length($0), $0 }' | sort -rn | cut -d" " -f2- || true)
    
    if [ ${#active_mounts[@]} -eq 0 ]; then
        if $JSON_MODE; then
            echo '{"ok":true,"unmounted":"","message":"Nenhum dispositivo montado"}'
        else
            log_warn "Nenhum dispositivo montado em pastas controladas por usb-driver"
        fi
        return 0
    fi

    if $JSON_MODE; then
        local unmounted_list="" first_u=true
        for mnt in "${active_mounts[@]}"; do
            if safe_unmount "$mnt" "${EXTRA_FLAGS[@]}" >/dev/null 2>&1; then
                $first_u || unmounted_list+=","
                first_u=false
                unmounted_list+="\"$(json_escape "$mnt")\""
            fi
        done
        printf '{"ok":true,"unmounted":[%s]}\n' "$unmounted_list"
        return 0
    fi
    
    # If multiple mounts, ask user
    if [ ${#active_mounts[@]} -gt 1 ]; then
        echo -e "\n${CYAN}▶${NC} ${BOLD}Múltiplos dispositivos encontrados:${NC}\n" >&2
        local i=1
        for mnt in "${active_mounts[@]}"; do
            local dev folder_name base_path
            dev=$(findmnt -n -o SOURCE "$mnt")
            folder_name=$(basename "$mnt")
            base_path=$(dirname "$mnt")
            echo -e "  ${BOLD}[$i]${NC} ${YELLOW}${base_path}/${NC}${CYAN}${folder_name}${NC} (${dev})" >&2
            ((i++))
        done
        echo -e "  ${BOLD}[a]${NC} Desmontar ${RED}TODOS${NC}" >&2
        echo >&2
        echo -n "  Escolha o que desmontar (ou 'q' para sair): " >&2
        read -r choice < /dev/tty
        
        if [ "$choice" = "a" ]; then
            for mnt in "${active_mounts[@]}"; do
                # Continue on error during batch unmount
                safe_unmount "$mnt" "${EXTRA_FLAGS[@]}" || true
            done
            return 0
        elif [ "$choice" = "q" ]; then
            echo -e "\n${GREEN}✓${NC} Até mais! Seus dispositivos permanecem montados." >&2
            return 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#active_mounts[@]} ]; then
            safe_unmount "${active_mounts[$((choice-1))]}" "${EXTRA_FLAGS[@]}"
            return 0
        else
            log_error "Opção inválida"
            return 1
        fi
    else
        # Only one mount, proceed directly
        safe_unmount "${active_mounts[0]}" "${EXTRA_FLAGS[@]}"
    fi
}

cmd_status() {
    local base_mount="${MOUNT_POINT:-$DEFAULT_MOUNT_POINT}"
    base_mount="${base_mount%/}"

    if $JSON_MODE; then
        if $SIMULATE_MODE; then
            printf '{"mountPoint":"%s","mounts":[{"device":"/dev/sdb1","target":"%s/BACKUP_LINUX","fstype":"ext4"}]}\n' \
                "$(json_escape "$base_mount")" "$(json_escape "$base_mount")"
            return 0
        fi
        local mounts_json="" first_m=true
        while IFS= read -r mnt; do
            if [ -n "$mnt" ]; then
                local dev fs
                dev=$(findmnt -n -o SOURCE "$mnt")
                fs=$(findmnt -n -o FSTYPE "$mnt")
                $first_m || mounts_json+=","
                first_m=false
                mounts_json+=$(printf '{"device":"%s","target":"%s","fstype":"%s"}' \
                    "$(json_escape "$dev")" "$(json_escape "$mnt")" "$(json_escape "$fs")")
            fi
        done < <(findmnt -lo TARGET -n | grep -E "^($base_mount|$LEGACY_MOUNT_POINT)($|/)" || true)
        printf '{"mountPoint":"%s","mounts":[%s]}\n' "$(json_escape "$base_mount")" "$mounts_json"
        return 0
    fi

    log_info "usb-driver v$VERSION"
    
    local found=false
    # Scan for both loop (HD) and USB mounts (including legacy path)
    while IFS= read -r mnt; do
        if [ -n "$mnt" ]; then
            local dev fs
            dev=$(findmnt -n -o SOURCE "$mnt")
            fs=$(findmnt -n -o FSTYPE "$mnt")
            log_success "Dispositivo: $dev -> $mnt ($fs)"
            found=true
        fi
    done < <(findmnt -lo TARGET -n | grep -E "^($base_mount|$LEGACY_MOUNT_POINT)($|/)" || true)
    
    if ! $found; then
        log_warn "Nenhum dispositivo montado em ${YELLOW}$base_mount${NC}"
        exit 1
    fi
}

cmd_install() {
    print_step "Instalando usb-driver globalmente..."
    local target="/usr/local/bin/usb-driver"
    
    # Use symlink instead of copy to keep access to libs
    log_info "Criando link simbólico para $target..."
    sudo ln -sf "$REAL_SCRIPT" "$target"
    
    log_success "Instalado com sucesso em $target"
    log_info "Agora você pode usar apenas 'usb-driver' de qualquer lugar."
}

# Attach a specific Windows USB device to WSL by BUSID
cmd_attach() {
    local busid="$1"
    
    if [ -z "$busid" ]; then
        if $JSON_MODE; then
            echo '{"ok":false,"message":"BUSID não especificado"}'
        else
            log_error "BUSID não especificado"
            log_hint "Uso: usb-driver attach <BUSID>"
            log_hint "Execute 'usb-driver list' para ver os BUSIDs disponíveis"
        fi
        return 1
    fi

    if ! validate_busid "$busid"; then
        if $JSON_MODE; then
            printf '{"ok":false,"message":"BUSID inválido: %s"}\n' "$(json_escape "$busid")"
        else
            log_error "BUSID inválido: $busid (formato esperado: X-Y, ex: 2-4)"
        fi
        return 1
    fi
    
    if ! $JSON_MODE; then
        print_step "Anexando dispositivo $busid ao WSL..."
    fi
    
    if ! check_usbipd_installed; then
        if $JSON_MODE; then
            echo '{"ok":false,"message":"usbipd-win não encontrado"}'
        else
            require_usbipd || true
        fi
        return 1
    fi
    
    # Try to attach
    if ! $JSON_MODE; then
        log_info "Executando: usbipd attach --wsl --busid $busid"
    fi
    
    local result
    result=$(attach_usb_raw "$busid" || true)
    
    if echo "$result" | grep -qi "error\|denied\|not shared"; then
        if $JSON_MODE; then
            printf '{"ok":false,"busid":"%s","needsBind":%s,"message":"%s"}\n' \
                "$(json_escape "$busid")" \
                "$(echo "$result" | grep -qi "not shared" && echo true || echo false)" \
                "$(json_escape "$result")"
        else
            log_error "Falha ao anexar dispositivo"
            if echo "$result" | grep -qi "not shared"; then
                log_warn "Dispositivo precisa ser compartilhado primeiro"
                echo
                log_info "Execute no PowerShell como ADMIN:"
                echo -e "    ${BOLD}usbipd bind --busid $busid --force${NC}"
                echo
                log_info "Depois tente novamente: usb-driver attach $busid"
            fi
        fi
        return 1
    fi
    
    # Wait for device to appear
    if ! $JSON_MODE; then
        log_info "Aguardando dispositivo aparecer no WSL..."
    fi
    sleep "$ATTACH_DELAY"
    
    if $JSON_MODE; then
        printf '{"ok":true,"busid":"%s","message":"Dispositivo anexado ao WSL"}\n' "$(json_escape "$busid")"
    else
        log_success "Dispositivo $busid anexado ao WSL"
        log_hint "Execute 'usb-driver list' para verificar"
    fi
    return 0
}

# =========================
# Main
# =========================
case "$COMMAND" in
    up|mount)
        cmd_up "$BUSID_ARG"
        ;;
    down|unmount)
        cmd_down "$BUSID_ARG"
        ;;
    status)
        cmd_status
        ;;
    list)
        # Disable set -e for device enumeration (grep may return 1 for empty results)
        set +e
        if $JSON_MODE; then
            list_available_devices_json
        else
            list_available_devices
        fi
        set -e
        ;;
    check)
        if $JSON_MODE; then
            run_health_check_json
        else
            run_health_check
        fi
        ;;
    install)
        cmd_install
        ;;
    attach)
        cmd_attach "$BUSID_ARG"
        ;;
    help|"")
        show_help
        ;;
    *)
        log_error "Comando desconhecido: $COMMAND"
        show_help
        exit 1
        ;;
esac
